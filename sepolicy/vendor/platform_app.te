binder_use(platform_app)
binder_call(platform_app, hal_camera_default)

allow platform_app hal_aidlbgservice_service:service_manager find;

allow platform_app adsprpcd_file:dir { getattr open read search };

allow platform_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app vendor_camera_data_file:file { getattr open read };

allow platform_app app_data_file:file execute;

allow platform_app hal_camera_synthetic_service:service_manager find;

# Properties
get_prop(platform_app, vendor_audio_prop)
get_prop(platform_app, vendor_camera_p3enable_prop)
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_display_prop)
get_prop(platform_app, vendor_displayfeature_prop)
get_prop(platform_app, vendor_panel_info_prop)

# Android 16 (SDK 36) assigns platform apps to platform_app_36 domain.
# Vendor sepolicy 202604 maps platform_app only to (platform_app), not
# platform_app_36, so we must duplicate all rules for the new domain.
binder_use(platform_app_36)
binder_call(platform_app_36, hal_camera_default)
binder_call(hal_camera_default, platform_app_36)

allow platform_app_36 hal_aidlbgservice_service:service_manager find;

allow platform_app_36 adsprpcd_file:dir { getattr open read search };

allow platform_app_36 vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_36 vendor_camera_data_file:file { getattr open read };

allow platform_app_36 app_data_file:file execute;

allow platform_app_36 hal_camera_synthetic_service:service_manager find;

get_prop(platform_app_36, vendor_audio_prop)
get_prop(platform_app_36, vendor_camera_p3enable_prop)
get_prop(platform_app_36, vendor_camera_sensor_prop)
get_prop(platform_app_36, vendor_display_prop)
get_prop(platform_app_36, vendor_displayfeature_prop)
get_prop(platform_app_36, vendor_panel_info_prop)
